    <string name="privacy_title">Privacy Information</string>
    <string name="privacy_your_privacy">Your Privacy Matters</string>
    <string name="privacy_your_privacy_body">MediTrack helps you manage medicine schedules and dose history. We use account and medicine information only to provide the app\'s features.</string>
    <string name="privacy_information_collected">Information We Collect</string>
    <string name="privacy_information_collected_body">Your name and email address, plus medicine names, dosage, frequency, reminder times, start and end dates, quantity and unit, and dose history such as status, scheduled time and snooze count. Your theme and language choices are saved on this device. Firebase Authentication manages your sign-in credentials; MediTrack does not save your password in your profile.</string>
    <string name="privacy_usage">How Your Information Is Used</string>
    <string name="privacy_usage_body">We use this information to manage schedules, show reminders, track Taken and Missed doses, calculate analytics, and maintain your account and preferences.</string>
    <string name="privacy_storage">Where Your Information Is Stored</string>
    <string name="privacy_storage_body">Your account and medicine records are stored in the Firebase services configured for MediTrack. Local appearance and language preferences remain on your device.</string>
    <string name="privacy_security">Data Security</string>
    <string name="privacy_security_body">Sign-in is handled by Firebase Authentication, and the app associates medicine records with the signed-in account. Data access also depends on the Firebase security rules deployed for the project. No security certification or absolute guarantee is implied.</string>
    <string name="privacy_control">Your Control</string>
    <string name="privacy_control_body">You can update medicine details, remove medicines, change appearance and language preferences on this device, or sign out. Dose history may remain after a medicine is removed. The app does not currently provide an in-app control to delete your account or all cloud data.</string>
    <string name="privacy_policy_note">Privacy Policy</string>
    <string name="privacy_policy_note_body">This information describes MediTrack\'s current data practices and is not a substitute for any applicable privacy policy. Review the applicable policy before using the app.</string>
    <string name="privacy_support_note">No support contact is configured in this app.</string>
