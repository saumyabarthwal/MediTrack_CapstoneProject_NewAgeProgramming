<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7F8FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="38dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#302544"
                android:textSize="38sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvFormHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_medicine_heading"
                    android:textColor="#302544"
                    android:textSize="32sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keep track of your medicine easily"
                    android:textColor="#7469A7"
                    android:textSize="17sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:padding="14dp"
                android:src="@drawable/ic_medicine_capsule"
                android:background="@drawable/bg_medicine_icon"
                android:contentDescription="@string/medicine_details" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/card_white"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicine Information"
                android:textColor="#302544"
                android:textSize="22sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etMedicineName"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:hint="@string/medicine_name_hint"
                android:inputType="textCapWords"
                android:background="@drawable/card_white"
                android:paddingHorizontal="18dp"
                android:textColor="#302544"
                android:textColorHint="#9389B3" />

            <EditText
                android:id="@+id/etDosage"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:hint="Dosage (e.g. 500 mg)"
                android:inputType="text"
                android:background="@drawable/card_white"
                android:paddingHorizontal="18dp"
                android:textColor="#302544"
                android:textColorHint="#9389B3" />

            <EditText
                android:id="@+id/etFrequency"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:hint="Frequency (e.g. Once a day)"
                android:inputType="text"
                android:background="@drawable/card_white"
                android:paddingHorizontal="18dp"
                android:textColor="#302544"
                android:textColorHint="#9389B3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/card_white"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reminder Schedule"
                android:textColor="#302544"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAddReminderTime"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:text="+  Add Reminder Time"
                android:textAllCaps="false"
                android:textColor="#5540C8"
                android:textSize="18sp"
                android:backgroundTint="#DDD4FF" />

            <TextView
                android:id="@+id/tvReminderTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/no_reminder_times"
                android:textColor="#7469A7"
                android:padding="10dp" />

            <ListView
                android:id="@+id/lvReminderTimes"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:divider="@android:color/transparent"
                android:dividerHeight="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/card_white"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicine Duration &amp; Stock"
                android:textColor="#302544"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">
                <EditText android:id="@+id/etStartDate" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:hint="@string/start_date_hint" android:focusable="false" android:clickable="true" android:background="@drawable/card_white" android:paddingHorizontal="14dp" android:textColorHint="#9389B3" />
                <EditText android:id="@+id/etEndDate" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:layout_marginStart="6dp" android:hint="@string/end_date_hint" android:focusable="false" android:clickable="true" android:background="@drawable/card_white" android:paddingHorizontal="14dp" android:textColorHint="#9389B3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <EditText android:id="@+id/etQuantity" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:hint="@string/quantity_hint" android:inputType="number" android:background="@drawable/card_white" android:paddingHorizontal="14dp" android:textColorHint="#9389B3" />
                <EditText android:id="@+id/etQuantityUnit" android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1" android:layout_marginStart="6dp" android:hint="Unit" android:inputType="text" android:background="@drawable/card_white" android:paddingHorizontal="14dp" android:textColorHint="#9389B3" />
            </LinearLayout>

            <EditText android:id="@+id/etAmountPerDose" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:hint="Amount consumed per dose" android:inputType="number" android:background="@drawable/card_white" android:paddingHorizontal="14dp" android:textColorHint="#9389B3" />
            <EditText android:id="@+id/etLowStockThreshold" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:hint="@string/low_stock_threshold_hint" android:inputType="number" android:background="@drawable/card_white" android:paddingHorizontal="14dp" android:textColorHint="#9389B3" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveMedicine"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="18dp"
            android:text="▣  Save Medicine"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="#5D48C7" />
    </LinearLayout>
</ScrollView>
