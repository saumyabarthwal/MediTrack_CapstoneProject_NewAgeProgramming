
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/medicine_details"
            android:textColor="@color/accent" android:textSize="15sp"
            android:textStyle="bold" android:layout_marginBottom="12dp"/>
        <TextView
            android:id="@+id/tvDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/medicine_name_hint"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingBottom="14dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/card_white">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/remaining_stock" android:textColor="@color/text_secondary"/>
            <TextView android:id="@+id/tvDetailRemaining"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="0 / 0 tablets" android:textSize="22sp" android:textStyle="bold"
                android:textColor="@color/text_primary" android:layout_marginTop="4dp"/>
            <ProgressBar android:id="@+id/progressStock" style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent" android:layout_height="8dp"
                android:layout_marginTop="10dp" android:max="100" android:progress="50"
                android:progressTint="@color/accent"/>
            <TextView android:id="@+id/tvDetailStatus" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/sufficient_stock"
                android:textStyle="bold" android:textColor="@color/accent" android:layout_marginTop="8dp"/>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider" android:layout_marginVertical="14dp"/>
            <TextView
                android:id="@+id/tvDetailDosage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dosage_hint"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:paddingBottom="14dp" />

            <TextView
                android:id="@+id/tvDetailTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reminder_times"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:paddingBottom="14dp" />

            <TextView
                android:id="@+id/tvDetailFrequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/frequency_hint"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:paddingBottom="14dp" />

            <TextView
                android:id="@+id/tvDetailDates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/start_date_hint"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:paddingBottom="14dp" />

            <TextView
                android:id="@+id/tvDetailQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quantity_hint"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:paddingBottom="14dp" />

            <TextView android:id="@+id/tvDetailAmount"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/text_secondary" android:textSize="16sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manage_medicine"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnEditMedicine"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="@string/edit_medicine"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="@color/accent"
            android:textColor="@color/text_on_accent"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnMarkTaken"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="@string/mark_as_taken"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#75B99A"
            android:textColor="@color/text_on_accent"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnMarkMissed"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="@string/automatic_missed_status"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#D9B46A"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnDeleteMedicine"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="@string/delete_medicine"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#C96F78"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>
