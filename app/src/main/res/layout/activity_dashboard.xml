<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_background">

    <ScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:background="@drawable/bg_dashboard_hero">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvWelcome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_welcome"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvHomeSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/health_companion"
                        android:textColor="#E8E3FF"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvAdherence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/adherence_empty"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <ImageView
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:padding="14dp"
                    android:src="@drawable/ic_medicine_capsule"
                    android:background="@drawable/bg_medicine_icon"
                    android:contentDescription="@string/medicine_details" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/daily_progress"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvMedicineCount"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:gravity="center"
                    android:background="@drawable/card_white"
                    android:text="@string/loading"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvTodayCount"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:background="@drawable/card_white"
                    android:text="@string/loading"
                    android:textColor="@color/accent_dark"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvTakenCount"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:gravity="center"
                    android:background="@drawable/card_white"
                    android:text="@string/loading"
                    android:textColor="@color/status_taken"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvMissedCount"
                    android:layout_width="0dp"
                    android:layout_height="74dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:background="@drawable/card_white"
                    android:text="@string/loading"
                    android:textColor="@color/status_missed"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvUpcomingCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="15dp"
                android:background="@drawable/card_white"
                android:text="@string/loading"
                android:textColor="@color/accent_dark"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvLowStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:padding="13dp"
                android:background="@drawable/card_lavender"
                android:text="@string/low_stock_medicines"
                android:textColor="@color/status_warning"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/tvMedicineSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/my_medicines"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/btnAddMedicine"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/add_medicine"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_accent"
                    android:backgroundTint="@color/accent" />
            </LinearLayout>

            <EditText
                android:id="@+id/etMedicineSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:hint="@string/search_medicines"
                android:background="@drawable/card_white"
                android:paddingHorizontal="14dp" />
            <Spinner
                android:id="@+id/spMedicineStatus"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/card_white"
                android:contentDescription="@string/filter_status_title" />

            <ListView
                android:id="@+id/lvMedicines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:divider="@android:color/transparent"
                android:dividerHeight="10dp"
                android:nestedScrollingEnabled="false" />
            <TextView
                android:id="@+id/tvEmptyMedicines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:gravity="center"
                android:text="@string/no_medicines_match"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/dashboardNavigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/card_white"
        android:elevation="12dp">
        <TextView
            android:id="@+id/btnDashboardHome"
            style="@style/DashboardNavItem"
            android:text="⌂&#10;Home"
            android:textColor="@color/accent" />
        <TextView
            android:id="@+id/btnDashboardMeds"
            style="@style/DashboardNavItem"
            android:text="◆&#10;Medicines" />
        <TextView
            android:id="@+id/btnHistory"
            style="@style/DashboardNavItem"
            android:text="◷&#10;History" />
        <TextView
            android:id="@+id/btnMore"
            style="@style/DashboardNavItem"
            android:text="•••&#10;More" />
    </LinearLayout>
    <TextView
        android:id="@+id/btnMissed"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
