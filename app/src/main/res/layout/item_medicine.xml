<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="220dp"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/card_white"
    android:elevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:padding="18dp"
            android:background="@drawable/bg_medicine_icon"
            android:src="@drawable/ic_medicine_capsule"
            android:contentDescription="@string/medicine_details" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMedicineCardName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#302544"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMedicineCardInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#7469A7"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvMedicineCardTimes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#7469A7"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#5540C8"
            android:textSize="38sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#E7E1EF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvMedicineCardStock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#5540C8"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMedicineCardStatus"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:textColor="#279E54"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/card_lavender" />

        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:gravity="center"
            android:text="✎"
            android:textColor="#5540C8"
            android:textSize="22sp"
            android:background="@drawable/bg_medicine_icon" />

        <TextView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="♲"
            android:textColor="#E04D63"
            android:textSize="22sp"
            android:background="@drawable/bg_medicine_icon" />
    </LinearLayout>
</LinearLayout>
